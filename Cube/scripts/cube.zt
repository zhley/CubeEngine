class Vec2 {
    var x = 0.0;
    var y = 0.0;

    fn _init(x, y) {
        this.x = x;
        this.y = y;
        return this;
    }

    fn _equals(other) {
        return this.x == other.x && this.y == other.y;
    }
}

class Vec3 {
    var x = 0.0;
    var y = 0.0;
    var z = 0.0;

    fn _init(x, y, z) {
        this.x = x;
        this.y = y;
        this.z = z;
        return this;
    }

    fn _equals(other) {
        return this.x == other.x && this.y == other.y && this.z == other.z;
    }
}

class Vec4 {
    var x = 0.0;
    var y = 0.0;
    var z = 0.0;
    var w = 0.0;

    fn _init(x, y, z, w) {
        this.x = x;
        this.y = y;
        this.z = z;
        this.w = w;
        return this;
    }

    fn _equals(other) {
        return this.x == other.x && this.y == other.y && this.z == other.z && this.w == other.w;
    }
}

class Color {
    var r = 0.0;
    var g = 0.0;
    var b = 0.0;
    var a = 1.0;

    fn _init(r, g, b, a) {
        this.r = r;
        this.g = g;
        this.b = b;
        this.a = a;
        return this;
    }

    fn _equals(other) {
        return this.r == other.r && this.g == other.g && this.b == other.b && this.a == other.a;
    }
}

