import "cube";

class Player {
    var update_count = 0;
    var entity = null;

    fn _init(entity) {
        this.entity = entity;
        print("Player._init\n");
        cb_log("_init: entity name = " + this.entity.get_name());
        return this;
    }

    fn start() {
        print("Player.start\n");
        var spriteRender = this.entity.add_component("SpriteRender");
        spriteRender.set("sprite", "spr:tex:icon.png");
    }

    fn update(dt) {
        var pos = this.entity.get_transform().get_pos();
        if (cb_is_key_pressed(KEY_W)) {
            pos.y += 1000.0 * dt;
        }
        if (cb_is_key_pressed(KEY_S)) {
            pos.y -= 1000.0 * dt;
        }
        if (cb_is_key_pressed(KEY_A)) {
            pos.x -= 1000.0 * dt;
        }
        if (cb_is_key_pressed(KEY_D)) {
            pos.x += 1000.0 * dt;
        }
        this.entity.get_transform().set_pos(pos);
    }
}
