import "cube";

class Player {
    var update_count = 0;
    var node = null;

    fn _init(node) {
        this.node = node;
        print("Player._init\n");
        cb_log("_init: node name = " + this.node.get_name());
        return this;
    }

    fn start() {
        print("Player.start\n");
        var spriteRender = this.node.add_component("SpriteRender");
        spriteRender.sprite = "spr:tex:icon.png";
    }

    fn update(dt) {
        this.update_count = this.update_count + 1;
        var pos = this.node.pos;
        if (cb_is_key_pressed(KEY_W)) {
            pos.y += 1000.0 * dt;
        }
        if (cb_is_key_pressed(KEY_S)) {
            pos.y -= 1000.0 * dt;
        }
        if (cb_is_key_pressed(KEY_A)) {
            pos.x -= 1000.0 * dt;
        }
        if (cb_is_key_pressed(KEY_D)) {
            pos.x += 1000.0 * dt;
        }
        this.node.pos = pos;
    }
}
